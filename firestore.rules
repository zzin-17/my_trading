rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isMoney(value) {
      return value is int || value is float;
    }

    function tradeTrashDocPath(userId, tradeId) {
      return /databases/$(database)/documents/users/$(userId)/trade_trash/$(tradeId);
    }

    function todoTrashDocPath(userId, todoId) {
      return /databases/$(database)/documents/users/$(userId)/todo_trash/$(todoId);
    }

    function validTradeDoc(tradeId) {
      return request.resource.data.keys().hasOnly([
          'id',
          'date',
          'ticker',
          'name',
          'sector',
          'market',
          'side',
          'quantity',
          'price',
          'currency',
          'note',
          'excludeFromJournal',
          'executionStatus',
          'updatedAt',
        ])
        && request.resource.data.id is string
        && request.resource.data.id == tradeId
        && request.resource.data.date is string
        && request.resource.data.ticker is string
        && request.resource.data.name is string
        && request.resource.data.sector is string
        && (request.resource.data.market == 'KR' || request.resource.data.market == 'US')
        && (request.resource.data.side == 'buy' || request.resource.data.side == 'sell')
        && request.resource.data.quantity is int
        && request.resource.data.quantity > 0
        && isMoney(request.resource.data.price)
        && request.resource.data.price >= 0
        && (
          request.resource.data.currency == 'KRW' ||
          request.resource.data.currency == 'USD'
        )
        && (!('note' in request.resource.data) || request.resource.data.note is string)
        && (
          !('excludeFromJournal' in request.resource.data) ||
          request.resource.data.excludeFromJournal is bool
        )
        && (
          !('executionStatus' in request.resource.data) ||
          request.resource.data.executionStatus == 'pending' ||
          request.resource.data.executionStatus == 'filled'
        )
        && request.resource.data.updatedAt is timestamp;
    }

    function canWriteTradeDoc(userId, tradeId) {
      return !existsAfter(tradeTrashDocPath(userId, tradeId));
    }

    function validTodoDoc(todoId) {
      return request.resource.data.keys().hasOnly([
          'id',
          'market',
          'ticker',
          'name',
          'action',
          'targetPrice',
          'quantity',
          'note',
          'done',
          'createdAt',
          'updatedAt',
        ])
        && request.resource.data.id is string
        && request.resource.data.id == todoId
        && (request.resource.data.market == 'KR' || request.resource.data.market == 'US')
        && request.resource.data.ticker is string
        && (!('name' in request.resource.data) || request.resource.data.name is string)
        && (
          request.resource.data.action == 'buy' ||
          request.resource.data.action == 'sell'
        )
        && isMoney(request.resource.data.targetPrice)
        && request.resource.data.targetPrice >= 0
        && request.resource.data.quantity is int
        && request.resource.data.quantity > 0
        && (!('note' in request.resource.data) || request.resource.data.note is string)
        && request.resource.data.done is bool
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is timestamp;
    }

    function canWriteTodoDoc(userId, todoId) {
      return !existsAfter(todoTrashDocPath(userId, todoId));
    }

    function validMetaDoc(docId) {
      return docId == 'v1'
        && request.resource.data.keys().hasOnly([
          'quotes',
          'positionIds',
          'notes',
          'quoteUpdatedAt',
          'lastKrQuoteBulkAt',
          'krSellCommissionRate',
          'krPreferExtendedQuote',
          'krDayOpenByTicker',
          'updatedAt',
        ])
        && request.resource.data.quotes is map
        && request.resource.data.positionIds is map
        && request.resource.data.notes is map
        && request.resource.data.quoteUpdatedAt is map
        && (
          !('lastKrQuoteBulkAt' in request.resource.data) ||
          request.resource.data.lastKrQuoteBulkAt is string ||
          request.resource.data.lastKrQuoteBulkAt == null
        )
        && isMoney(request.resource.data.krSellCommissionRate)
        && request.resource.data.krPreferExtendedQuote is bool
        && request.resource.data.krDayOpenByTicker is map
        && request.resource.data.updatedAt is timestamp;
    }

    function validSnapshotDoc(docId) {
      return docId is string
        && request.resource.data.keys().hasOnly([
          'body',
          'reason',
          'sourceDeviceId',
          'tradeCount',
          'todoCount',
          'latestTradeDate',
          'createdAt',
        ])
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 1000000
        && request.resource.data.reason is string
        && (
          !('sourceDeviceId' in request.resource.data) ||
          request.resource.data.sourceDeviceId is string ||
          request.resource.data.sourceDeviceId == null
        )
        && request.resource.data.tradeCount is int
        && request.resource.data.tradeCount >= 0
        && request.resource.data.todoCount is int
        && request.resource.data.todoCount >= 0
        && (
          !('latestTradeDate' in request.resource.data) ||
          request.resource.data.latestTradeDate is string ||
          request.resource.data.latestTradeDate == null
        )
        && request.resource.data.createdAt is timestamp;
    }

    function validTradeTrashDoc(docId) {
      return docId is string
        && request.resource.data.keys().hasOnly([
          'itemId',
          'ticker',
          'name',
          'date',
          'body',
          'reason',
          'sourceDeviceId',
          'deletedAt',
        ])
        && request.resource.data.itemId is string
        && request.resource.data.itemId == docId
        && request.resource.data.ticker is string
        && request.resource.data.name is string
        && request.resource.data.date is string
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 200000
        && request.resource.data.reason is string
        && (
          !('sourceDeviceId' in request.resource.data) ||
          request.resource.data.sourceDeviceId is string ||
          request.resource.data.sourceDeviceId == null
        )
        && request.resource.data.deletedAt is timestamp;
    }

    function validTodoTrashDoc(docId) {
      return docId is string
        && request.resource.data.keys().hasOnly([
          'itemId',
          'ticker',
          'name',
          'createdAtValue',
          'body',
          'reason',
          'sourceDeviceId',
          'deletedAt',
        ])
        && request.resource.data.itemId is string
        && request.resource.data.itemId == docId
        && request.resource.data.ticker is string
        && request.resource.data.name is string
        && request.resource.data.createdAtValue is string
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 200000
        && request.resource.data.reason is string
        && (
          !('sourceDeviceId' in request.resource.data) ||
          request.resource.data.sourceDeviceId is string ||
          request.resource.data.sourceDeviceId == null
        )
        && request.resource.data.deletedAt is timestamp;
    }

    function validEventDoc(docId) {
      return docId is string
        && request.resource.data.keys().hasOnly([
          'action',
          'entityType',
          'entityId',
          'sourceDeviceId',
          'summary',
          'createdAt',
        ])
        && request.resource.data.action is string
        && request.resource.data.entityType is string
        && request.resource.data.entityId is string
        && (
          !('sourceDeviceId' in request.resource.data) ||
          request.resource.data.sourceDeviceId is string ||
          request.resource.data.sourceDeviceId == null
        )
        && request.resource.data.summary is string
        && request.resource.data.createdAt is timestamp;
    }

    // 이전 버전 전체 스냅샷 백업: 경로 users/{uid}/traderos/v1
    match /users/{userId}/traderos/{docId} {
      allow get: if request.auth != null
        && request.auth.uid == userId
        && docId == 'v1';

      // updatedAt은 앱에서 serverTimestamp() 사용 → 규칙에서는 timestamp 타입만 검사
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && docId == 'v1'
        && request.resource.data.keys().hasOnly(['body', 'updatedAt'])
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 1000000
        && request.resource.data.updatedAt is timestamp;

      allow delete, list: if false;
    }

    // 실시간 동기화용 거래 컬렉션
    match /users/{userId}/trades/{tradeId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && validTradeDoc(tradeId)
        && canWriteTradeDoc(userId, tradeId);
      allow delete: if isOwner(userId);
    }

    // 실시간 동기화용 To-do 컬렉션
    match /users/{userId}/todos/{todoId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && validTodoDoc(todoId)
        && canWriteTodoDoc(userId, todoId);
      allow delete: if isOwner(userId);
    }

    // 실시간 동기화용 보조 메타 상태
    match /users/{userId}/traderos_meta/{docId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && validMetaDoc(docId);
      allow delete: if false;
    }

    match /users/{userId}/portfolio_snapshots/{docId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && validSnapshotDoc(docId);
      allow delete: if false;
    }

    match /users/{userId}/trade_trash/{docId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && validTradeTrashDoc(docId);
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/todo_trash/{docId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && validTodoTrashDoc(docId);
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/portfolio_events/{docId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && validEventDoc(docId);
      allow delete: if false;
    }

    // 위에서 허용한 경로 외에는 전부 거부(명시)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
