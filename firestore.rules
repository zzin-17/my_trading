rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // TraderOS 클라우드 스냅샷: 경로 users/{uid}/traderos/v1, 필드 body·updatedAt
    // 로그인한 본인만 접근, 문서 ID는 v1만 허용
    // delete·list 금지: 단건 get/setDoc만 사용(컬렉션 나열·문서 삭제 불가)
    match /users/{userId}/traderos/{docId} {
      allow get: if request.auth != null
        && request.auth.uid == userId
        && docId == 'v1';

      // updatedAt은 앱에서 serverTimestamp() 사용 → 규칙에서는 timestamp 타입만 검사
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && docId == 'v1'
        && request.resource.data.keys().hasOnly(['body', 'updatedAt'])
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 1000000
        && request.resource.data.updatedAt is timestamp;

      allow delete, list: if false;
    }

    // 위에서 허용한 경로 외에는 전부 거부(명시)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
