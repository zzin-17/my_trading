{
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ],
  "hosting": {
    "site": "my-trading-f14ae",
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "/",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/index.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ],
    "rewrites": [
      {
        "source": "/api/kr-quote",
        "function": "krQuote"
      },
      {
        "source": "/api/kr-index",
        "function": "krIndex"
      },
      {
        "source": "/api/krx-kind",
        "function": "krxKind"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
